# AI Gateway (LLM + embeddings). See lib/llm/model.ts and lib/retrieval/embed.ts.
AI_GATEWAY_API_KEY=

# Free alternative to AI_GATEWAY_API_KEY for the capability-graph pack
# (src/models/index.ts): calls Gemini directly, no Vercel Gateway credits
# needed. Get one at https://aistudio.google.com/apikey. Only used when
# AI_GATEWAY_API_KEY is unset — the Gateway is preferred when both are set.
GOOGLE_GENERATIVE_AI_API_KEY=

# Override the default model (anthropic/claude-sonnet-4-5).
INTEGRELLI_MODEL=

# Must be exactly "true" to allow live (non-mock) execution.
INTEGRELLI_ALLOW_LIVE=false

# --- Per-service integration credentials ---
# Only key NAMES are ever referenced by the knowledge pack; values are never
# read outside lib/exec/live-adapter.ts.

ELEVENLABS_API_KEY=

STRIPE_API_KEY=

GMAIL_ACCESS_TOKEN=

SLACK_BOT_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

NOTION_API_KEY=

OPENAI_API_KEY=

AIRTABLE_API_KEY=
