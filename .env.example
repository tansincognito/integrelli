# AI Gateway (LLM + embeddings). See lib/llm/model.ts and lib/retrieval/embed.ts.
AI_GATEWAY_API_KEY=

# Free alternative to AI_GATEWAY_API_KEY for planner/extraction only (no
# embeddings endpoint) — routes through OpenRouter's OpenAI-compatible API.
# Use a ":free"-suffixed model id (see src/models/index.ts) to stay on
# OpenRouter's free tier; rate/availability limited, not for production load.
# Get one at https://openrouter.ai/settings/keys. Used when AI_GATEWAY_API_KEY
# is unset; ignored when it's set.
OPENROUTER_API_KEY=

# Free alternative for BOTH planner/extraction and embeddings (the one
# OpenRouter can't cover) — calls Gemini directly, no Vercel Gateway credits
# needed. Get one at https://aistudio.google.com/apikey. Used when neither
# AI_GATEWAY_API_KEY nor OPENROUTER_API_KEY is set (or, for embeddings, when
# AI_GATEWAY_API_KEY alone is unset).
GOOGLE_GENERATIVE_AI_API_KEY=

# Override the default model (anthropic/claude-sonnet-4-5).
INTEGRELLI_MODEL=

# Must be exactly "true" to allow live (non-mock) execution.
INTEGRELLI_ALLOW_LIVE=false

# --- Per-service integration credentials ---
# Only key NAMES are ever referenced by the knowledge pack; values are never
# read outside lib/exec/live-adapter.ts.

ELEVENLABS_API_KEY=

STRIPE_API_KEY=

GMAIL_ACCESS_TOKEN=

SLACK_BOT_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

NOTION_API_KEY=

OPENAI_API_KEY=

AIRTABLE_API_KEY=
